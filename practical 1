# Set up a Python environment for AI and implement a simple reflex or goalbased agent in a toy environment.
room = ["D", "C", "D", "D", "C"]
def show_room(room):
picture=""
for spot in room:
if spot=="D":
picture += " "
else:
picture += " "
print(picture)
print("This is our room")
show_room(room)
def clean_spot(spot):
if spot == "D":
return "C"
else:
return "C"
result = clean_spot("D")
print("The robot looked at dirty spot and made it:", result,"(C stands for Clean)")
print("BEFORE - the dirty room")
show_room(room)
for i in range(len(room)):
room[i] = clean_spot(room[i])
print("AFTER cleaning spot number", i + 1,":")
show_room(room)
print()
print("AFTER - all done!")
